<?xml version="1.0" encoding="UTF-8"?>

<window>
    <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
    <animation effect="fade" start="100" end="0" time="150">WindowClose</animation>

    <controls>
        <!-- FIX PRE-EMPTIVE AND FILTERS: focus directly on the populated menu -->
        <!-- Hlavní kontejner dialogu -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>1400</width>
            <height>850</height>

            <!-- SOLIDNÍ POZADÍ OKNA -->
            <!-- Využívá AF3 dialog.webp pro zaoblené rohy okna -->
            <control type="image">
                <!-- Fade only the panel background; keep content fully opaque. -->
                <animation effect="fade" start="70" end="70" condition="true">Conditional</animation>
                <left>0</left>
                <top>0</top>
                <width>100%</width>
                <height>100%</height>
                <texture border="30" fallback="common/white.webp">common/dialog.webp</texture>
                <colordiffuse>$INFO[Window.Property(play_er.Background)]</colordiffuse>
            </control>

            <!-- Hlavička (Nadpis menu) -->
            <control type="label">
                <left>50</left>
                <top>30</top>
                <width>1300</width>
                <height>50</height>
                <font>font_head_bold</font>
                <textcolor>FFFF9900</textcolor>
                <shadowcolor>black</shadowcolor>
                <align>center</align>
                <label>$INFO[Window.Property(DialogTitle)]</label>
            </control>

            <!-- DĚLÍCÍ ČÁRA POD HLAVIČKOU -->
            <control type="image">
                <left>30</left>
                <top>80</top>
                <width>1340</width>
                <height>2</height>
                <texture>common/white.webp</texture>
                <colordiffuse>33FFFFFF</colordiffuse>
            </control>

            <!-- Levý panel: Obal pro plakát a metadata -->
            <control type="group">
                <left>50</left>
                <top>110</top>
                <width>400</width>
                <height>700</height>

                <!-- Plakát Titulu -->
                <control type="image">
                    <left>0</left>
                    <top>0</top>
                    <width>400</width>
                    <height>500</height>
                    <aspectratio align="center" aligny="top">keep</aspectratio>
                    <texture fallback="DefaultVideo.png">$INFO[Window.Property(MediaPoster)]</texture>
                </control>

                <!-- Plot (Popis děje) -->
                <control type="textbox">
                    <left>0</left>
                    <top>520</top>
                    <width>400</width>
                    <height>170</height>
                    <font>font12</font>
                    <textcolor>$INFO[Window.Property(play_er.Muted)]</textcolor>
                    <label>$INFO[Window.Property(MediaPlot)]</label>
                    <autoscroll time="3000" delay="5000" repeat="5000">true</autoscroll>
                </control>
            </control>

            <!-- Pravý panel: Akční seznam menu -->
            <control type="list" id="1000">
                <left>500</left>
                <top>110</top>
                <width>850</width>
                <height>700</height>
                <onup>1000</onup>
                <ondown>1000</ondown>
                <onleft>60</onleft>
                <onright>60</onright>
                <pagecontrol>60</pagecontrol>
                <scrolltime>200</scrolltime>

                <!-- Vzhled položky (nevybrané) -->
                <itemlayout height="70" width="850">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>100%</width>
                        <height>60</height>
                        <texture border="20" fallback="common/white.webp">common/selectbox_thin.webp</texture>
                        <colordiffuse>26FFFFFF</colordiffuse>
                        <visible>!String.IsEqual(ListItem.Property(IsHeader),true)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>0</top>
                        <width>810</width>
                        <height>60</height>
                        <font>font14</font>
                        <textcolor>$INFO[Window.Property(play_er.Muted)]</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <aligny>center</aligny>
                    </control>
                </itemlayout>

                <!-- Vzhled položky (vybrané/focused) -->
                <focusedlayout height="70" width="850">
                    <control type="image">
                        <left>0</left>
                        <top>0</top>
                        <width>100%</width>
                        <height>60</height>
                        <texture border="20" fallback="common/white.webp">common/selectbox_thin.webp</texture>
                        <colordiffuse>FFFF9900</colordiffuse>
                        <visible>!String.IsEqual(ListItem.Property(IsHeader),true)</visible>
                    </control>
                    <control type="label">
                        <left>20</left>
                        <top>0</top>
                        <width>810</width>
                        <height>60</height>
                        <font>font14</font>
                        <textcolor>$INFO[Window.Property(play_er.Text)]</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                        <aligny>center</aligny>
                        <animation effect="zoom" start="100" end="102" center="auto" time="150">Focus</animation>
                    </control>
                </focusedlayout>
            </control>

            <!-- Posuvník: Textury odstraněny = převezme se nativní nádherný vzhled ze skinu -->
            <control type="scrollbar" id="60">
                <!-- FIX PRE-EMPTIVE AND FILTERS: explicit focus return and visible scrollbar -->
                <onleft>1000</onleft><onright>1000</onright>
                <onup>1000</onup><ondown>1000</ondown>
                <texturesliderbackground colordiffuse="33FFFFFF">common/white.webp</texturesliderbackground>
                <texturesliderbar colordiffuse="FF999999">common/scrollv.webp</texturesliderbar>
                <texturesliderbarfocus colordiffuse="FFFF9900">common/scrollv.webp</texturesliderbarfocus>
                <left>1360</left>
                <top>110</top>
                <width>12</width>
                <height>700</height>
                <showonepage>false</showonepage>
                <orientation>vertical</orientation>
            </control>
        </control>
    </controls>
</window>
