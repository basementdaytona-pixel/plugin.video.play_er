msgctxt "#30003"
msgid "Main switch to enable or disable limits when searching for content."
msgstr "Hlavní přepínač pro zapnutí nebo vypnutí limitů při vyhledávání obsahu."

msgctxt "#30005"
msgid "Determines how many result pages to load from the source at once."
msgstr "Určuje, kolik stránek s výsledky se má najednou načíst ze zdroje."

msgctxt "#30017"
msgid "Maximum number of results downloaded from Prehraj.to server."
msgstr "Maximální počet výsledků stahovaných ze serveru Prehraj.to"

msgctxt "#30032"
msgid "Maximum number of results downloaded from Webshare.cz server."
msgstr "Maximální počet výsledků stahovaných ze serveru Webshare.cz"

msgctxt "#30034"
msgid "Criterion for sorting search results on Webshare.cz."
msgstr "Kritérium pro řazení výsledků vyhledávání na Webshare.cz"

msgctxt "#30048"
msgid "Waiting time in seconds before the next network request to avoid IP blocking."
msgstr "Doba čekání v sekundách před dalším síťovým požadavkem, aby nedošlo k zablokování IP."

msgctxt "#30061"
msgid "Settings for the watched and history section. Allows customization of the display."
msgstr "Nastavení pro sekci sledovaných a historie. Umožňuje přizpůsobit zobrazení."

msgctxt "#30063"
msgid "Maximum number of history or watched pages to load."
msgstr "Kolik stránek historie nebo sledovaných se maximálně načte."

msgctxt "#30065"
msgid "Maximum number of items the plugin remembers in playback history."
msgstr "Maximální počet položek, které si plugin pamatuje v historii přehrávání."

msgctxt "#30079"
msgid "Over what period to display the most watched movies and series."
msgstr "Za jaké období se mají zobrazovat nejsledovanější filmy a seriály."

msgctxt "#30085"
msgid "Activates advanced content filtering using custom expressions."
msgstr "Aktivuje pokročilé filtrování obsahu pomocí vlastních výrazů."

msgctxt "#30087"
msgid "Enables automatic reporting of what you are currently watching to your Trakt.tv account."
msgstr "Zapne automatické odesílání informací o tom, co právě sledujete, na váš účet Trakt.tv"

msgctxt "#30105"
msgid "Automatically generates a playlist from found movies for continuous playback."
msgstr "Automaticky generuje playlist z nalezených filmů pro plynulé přehrávání za sebou."

msgctxt "#30215"
msgid "Path where  ( STRM )  files will be saved for Kodi local library integration."
msgstr "Složka pro ukládání souborů pro integraci knihovny Kodi  ( STRM ) "

msgctxt "#30220"
msgid "SQLITE is sufficient for normal use. Choose MYSQL for sharing history between multiple devices."
msgstr "Pro běžné použití stačí SQLITE. Pro sdílení historie mezi vícero zařízeními zvolte MYSQL."

msgctxt "#30257"
msgid "A message will be sent to Telegram when a new episode of a favorite series is released."
msgstr "Při vydání nové epizody oblíbeného seriálu vám přijde zpráva na Telegram."

msgctxt "#30271"
msgid "Forces selected display mode  ( Posters, List )  for the Main Menu."
msgstr "Vynutí vybraný vzhled zobrazení  ( Plakáty, Seznam )  pro Hlavní menu."

msgctxt "#30308"
msgid "Select the type of files to search for  ( VIDEO, AUDIO, ARCHIVES )."
msgstr "Vyberte typ souborů, které se budou hledat  ( VIDEO, AUDIO, ARCHIVY )."

msgctxt "#30309"
msgid "Displays advanced plugin settings  ( for experienced users )."
msgstr "Zobrazí pokročilá nastavení pluginu  ( pro zkušenější uživatele )."

msgctxt "#30310"
msgid "Allows changing the display mode  ( Poster, List, Gallery )  in the plugin."
msgstr "Umožní změnu režimu zobrazení  ( Plakát, Seznam, Galerie )  v pluginu."

msgctxt "#30311"
msgid "Displays Trakt.tv integration settings  ( scrobbling, social feed )."
msgstr "Zobrazí nastavení integrace s Trakt.tv  ( scrobbling, social feed )."

msgctxt "#30312"
msgid "First Trakt.tv user for social feed."
msgstr "První Trakt.tv uživatel pro sociální feed."

msgctxt "#30313"
msgid "Second Trakt.tv user for social feed."
msgstr "Druhý Trakt.tv uživatel pro sociální feed."

msgctxt "#30314"
msgid "Third Trakt.tv user for social feed."
msgstr "Třetí Trakt.tv uživatel pro sociální feed."

msgctxt "#30315"
msgid "How many items from Trakt.tv social feed to load in lists."
msgstr "Kolik položek ze sociálního feed Trakt.tv se načte v seznamech."

msgctxt "#30316"
msgid "How many items per page to load when browsing on Trakt.tv."
msgstr "Kolik položek na stránku se načte při procházení na Trakt.tv."

msgctxt "#30317"
msgid "Prioritizes Czech results when searching on Trakt.tv for localization."
msgstr "Upřednostní české výsledky při vyhledávání na Trakt.tv pro lokalizaci."

msgctxt "#30318"
msgid "Displays the release / update time of the item in the Trakt.tv feed."
msgstr "Zobrazí čas uvedení / aktualizace položky v Trakt.tv feed."

msgctxt "#30319"
msgid "Displays additional information  ( description )  for Trakt.tv feed items."
msgstr "Zobrazí doplňující informace  ( popis )  u položek Trakt.tv feed."

msgctxt "#30320"
msgid "Displays additional context  ( rating, genres )  from Trakt.tv in details."
msgstr "Zobrazí doplňující kontext  ( hodnocení, žánry )  z Trakt.tv v detailech."

msgctxt "#30321"
msgid "Sets default movie auto-play behavior."
msgstr "Nastaví výchozí chování automatického přehrávání filmů."

msgctxt "#30322"
msgid "Determines how many movies to pre-load into the playlist for smooth playback."
msgstr "Určuje, kolik filmů se přednačte do playlistu pro plynulé přehrávání."

msgctxt "#30323"
msgid "Allows manual selection of the source for generating autolists."
msgstr "Umožní ručně vybrat zdroj, ze kterého se budou generovat autolisty."

msgctxt "#30324"
msgid "Method for selecting autolist source  ( first available, by order, intelligent )."
msgstr "Způsob výběru zdroje pro autolist  ( první dostupný, podle pořadí, inteligentní )."

msgctxt "#30325"
msgid "Sets source priority when collecting results for autolist."
msgstr "Nastavuje prioritu zdrojů při sběru výsledků pro autolist."

msgctxt "#30326"
msgid "Enables automatic creation of a video list  ( autolist )  from search results."
msgstr "Zapne automatické vytváření seznamu videí  ( autolist )  z výsledků vyhledávání."

msgctxt "#30327"
msgid "Automatically plays the next episode of the series after the current episode ends."
msgstr "Po skončení epizody automaticky přehraje další epizodu seriálu."

msgctxt "#30328"
msgid "Number of items added to the autolist when it starts."
msgstr "Počet položek, které se do autolistu přidají při jeho spuštění."

msgctxt "#30329"
msgid "Allows selecting a source for the series autolist."
msgstr "Umožní vybrat zdroj pro autolist seriálů."

msgctxt "#30330"
msgid "Source selection method for the series autolist."
msgstr "Způsob výběru zdroje pro autolist seriálů."

msgctxt "#30331"
msgid "Source priority when creating the series autolist."
msgstr "Priorita zdrojů při vytváření autolistu pro seriály."

msgctxt "#30332"
msgid "Automatically selects a source for a library item. When disabled, shows a source selection dialog."
msgstr "Automatically selects a source for a library item. When disabled, shows a source selection dialog."

msgctxt "#30333"
msgid "First available keeps provider/global ordering after library exclusions. Intelligent also ranks library keyword preferences."
msgstr "First available keeps provider/global ordering after library exclusions. Intelligent also ranks library keyword preferences."

msgctxt "#30334"
msgid "Pre-loads available sources before item selection for faster result display \n[COLOR orange][  TURN OFF   |   PLAYER > VIDEO > PLAY NEXT   >   SERIES + EPISODES  ][/COLOR]"
msgstr "Načte automaticky zdroje na pozadí pro plynulejší přechod mezi položkami v playlistu \n[COLOR orange][  NUTNO VYPNOUT   |   PŘEHRÁVAČ > VIDEA > PŘEHRÁT DALŠÍ   >   SERIÁLY + EPIZODY  ][/COLOR]"

msgctxt "#30335"
msgid "Displays option to skip end credits and immediately play the next episode."
msgstr "Zobrazí výzvu pro přeskočení závěrečných titulků a okamžité přehrání další epizody."

msgctxt "#30336"
msgid "Sorts results by file size in ascending order  ( smaller files first )."
msgstr "Seřadí výsledky podle velikosti souboru vzestupně  ( menší soubory první )"

